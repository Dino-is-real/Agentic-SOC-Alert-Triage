# Adaptive Trust-Aware SOC Framework Environment Configuration

APP_NAME=adaptive-soc
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_f728c31e9a4d8b5

# Database (PostgreSQL + pgvector / SQLite fallback for in-memory testing)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adaptive_soc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptive_soc
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/adaptive_soc

# Redis
REDIS_URL=redis://localhost:6379/0

# Trust Engine Parameters (PPT Baseline Defaults)
TRUST_WEIGHT_CONSENSUS=0.50
TRUST_WEIGHT_HISTORICAL=0.30
TRUST_WEIGHT_PENALTY=0.20
TRUST_DEFAULT_THRESHOLD=0.65
ROUTER_CONFIDENCE_THRESHOLD=0.50

# LLM Providers (Mock by default for offline determinism)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_OLLAMA_URL=http://localhost:11434

# Threat Intel APIs (Mocks enabled by default)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
ENABLE_MOCK_INTEGRATIONS=true
