# Adaptive Trust-Aware SOC Framework Environment Configuration

# Application
APP_NAME=adaptive-soc
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_f728c31e9a4d8b5

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adaptive_soc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptive_soc
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/adaptive_soc

# Redis
REDIS_URL=redis://localhost:6379/0

# Trust Engine Parameters (Calibrated Operational Baselines)
TRUST_WEIGHT_CONSENSUS=0.60
TRUST_WEIGHT_HISTORICAL=0.25
TRUST_WEIGHT_PENALTY=0.15
TRUST_DEFAULT_THRESHOLD=0.50
ROUTER_CONFIDENCE_THRESHOLD=0.50

# LLM Providers (mock, groq, openai, anthropic, ollama)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LOCAL_OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Threat Intel APIs (Mocks enabled by default)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
ENABLE_MOCK_INTEGRATIONS=true
